# BNB Chain mainnet archive RPC used by the fork tests and deploy scripts
BSC_MAINNET_RPC=
BSC_TESTNET_RPC=
# One Etherscan V2 key covers BSC and every other supported chain
ETHERSCAN_API_KEY=
# Block the fork tests pin to; unset to run against latest
FORK_BLOCK=116350000
# Deployer key, only needed when running a Universal Router deployment script
PRIVATE_KEY=

# Routing API: defaults to BNB; 4663 selects the deployed Robinhood stack
# CHAIN_ID=4663
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# RPC_URLS=...
# SUBGRAPH_URL=...
# SUBGRAPH_CACHE_TTL_MS=30000
# Multiple enabled chains (see docs/MULTICHAIN.md)
# CHAINS_CONFIG_FILE=config/chains.example.json
# Router deployment/fork tests on Robinhood
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Base router deployment/fork tests
# BASE_RPC_URL=https://mainnet.base.org
# Ethereum router deployment and fork tests; chain 1 is enabled in the production API
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# ETHEREUM_UNIVERSAL_ROUTER=0x606794d37991A426a189fD9FA8664D339A77f8ae

# Routing API secret overrides, including when CHAINS_CONFIG_FILE is set.
# Comma-separated private primary and optional fallback (up to two endpoints).
# Keep real credentials out of this template; no Fly secrets were changed.
# ROUTING_RPC_URLS_56=
# ROUTING_RPC_URLS_4663=
# ROUTING_RPC_URLS_8453=
# ROUTING_RPC_URLS_1=
