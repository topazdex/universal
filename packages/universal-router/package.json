  "license": "GPL-3.0-or-later",
  "author": "Topaz Dex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/topazdex/universal.git",
    "directory": "packages/universal-router"
  },
  "homepage": "https://github.com/topazdex/universal/tree/main/packages/universal-router#readme",
  "bugs": "https://github.com/topazdex/universal/issues",
  "keywords": [
    "topaz",
    "topazdex",
