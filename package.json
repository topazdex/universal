{
  "name": "topaz-universal",
  "version": "0.1.0",
  "private": true,
  "description": "Topaz Dex routing monorepo: Universal Router, SDKs, smart order router and routing API",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@4.17.1",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "yarn workspaces foreach --all --topological-dev run build",
    "test": "yarn workspaces foreach --all run test",
    "lint": "yarn workspaces foreach --all run lint",
    "test:router": "yarn workspace @topaz/universal-router test"
  }
}
